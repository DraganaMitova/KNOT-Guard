{
  "name": "@knot/guard",
  "version": "0.1.0",
  "description": "Authority-governed execution for sensitive TypeScript backend actions.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "knot-guard": "./bin/knot-guard.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json --noEmit && npm run build && node --test test/*.test.mjs",
    "benchmark": "npm run build && node benchmarks/authority-flow.mjs"
  },
  "keywords": [
    "authorization",
    "governance",
    "audit",
    "runtime",
    "security",
    "ai-agents"
  ],
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "embedded-postgres": "^18.3.0-beta.17",
    "pg": "^8.20.0"
  }
}
