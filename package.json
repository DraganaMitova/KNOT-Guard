{
  "name": "knot-guard-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "KNOT Guard: authority-governed execution for sensitive software actions.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "security:package": "node scripts/check-package-safety.mjs",
    "benchmark": "npm --workspace @knot/guard run benchmark",
    "demo": "npm --workspace @knot/bank-admin-demo run dev",
    "api": "npm --workspace @knot/authority-runtime-api start"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
